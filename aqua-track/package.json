{
  "name": "aqua-track",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key ./localhost+2-key.pem --experimental-https-cert ./localhost+2.pem",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "supabase:start": "PATH=\"$HOME/.docker/bin:/Applications/Docker.app/Contents/Resources/bin:$PATH\" supabase start",
    "supabase:stop": "PATH=\"$HOME/.docker/bin:/Applications/Docker.app/Contents/Resources/bin:$PATH\" supabase stop",
    "supabase:status": "PATH=\"$HOME/.docker/bin:/Applications/Docker.app/Contents/Resources/bin:$PATH\" supabase status",
    "seed:local": "node scripts/seed-local-test-data.mjs",
    "seed:production-demo:dry-run": "node scripts/seed-production-demo-data.mjs --dry-run",
    "seed:production-demo": "node scripts/seed-production-demo-data.mjs --apply --confirm-production-write",
    "verify:production-demo": "node scripts/seed-production-demo-data.mjs --verify-only"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "pg": "^8.23.1",
    "qr-scanner": "^1.4.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
